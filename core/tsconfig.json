{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "Node16",
        "moduleResolution": "Node16",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "declaration": true,
        "outDir": "dist",
        "rootDir": "."
    },
    "include": ["*.ts"],
    "exclude": ["*.test.ts"]
}
