        "@vitejs/plugin-react": "^6.1.2",
        "prettier": "^3.9.10",
        "typescript": "~7.0.2",
        "vite": "^8.3.4",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.0.5"
    },
    "packageManager": "pnpm@12.14.0"
