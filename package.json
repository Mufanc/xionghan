{
    "name": "xionghan",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@12.14.0",
    "scripts": {
        "dev": "pnpm --filter @xionghan/web dev",
        "dev:server": "pnpm --filter @xionghan/core build && pnpm --parallel --filter @xionghan/core --filter @xionghan/server dev",
        "build": "pnpm -r build",
        "preview": "pnpm --filter @xionghan/web preview",
        "test": "pnpm --filter @xionghan/core build && pnpm -r test",
        "test:random": "pnpm --filter @xionghan/core test:random",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "prettier": "^3.9.10",
        "typescript": "~7.0.2",
        "vitest": "^5.0.5"
    }
}
