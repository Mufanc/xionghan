{
    "name": "xionghan",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc -b && vite build",
        "preview": "vite preview --host 127.0.0.1",
        "test": "vitest run --exclude \"**/random-play.test.ts\"",
